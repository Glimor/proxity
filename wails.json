{
  "$schema": "https://wails.io/schemas/config.v2.json",
  "name": "Proxity",
  "outputfilename": "proxity",
  "frontend:install": "npm ci",
  "frontend:build": "npm run build",
  "frontend:dev:watcher": "npm run dev",
  "frontend:dev:serverUrl": "auto",
  "frontend:dir": "frontend",
  "preBuildHooks": {
    "windows/*": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/prepare-build.ps1"
  },
  "author": {
    "name": "Glimor"
  },
  "info": {
    "productName": "Proxity",
    "productVersion": "0.1.0",
    "companyName": "Proxity",
    "copyright": "GPL-3.0",
    "comments": "Per-application proxy routing for Windows"
  }
}
